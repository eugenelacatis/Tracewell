{
  "name": "@tracewell/sdk",
  "version": "0.1.0",
  "description": "Tracewell SDK for Node: traces, spans and LLM generations, batched to ingest-svc over HTTP or gRPC.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@grpc/grpc-js": "^1.14.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "~3.2.7"
  }
}
